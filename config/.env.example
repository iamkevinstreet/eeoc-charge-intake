# Secrets only; every other setting lives in config/config.toml.
# Copy this file to config/.env and fill in what you need. Never commit config/.env.
# Only the key for the provider set in [llm] provider is needed.
# The default provider, fake, is the offline stand-in and needs none.

# The Anthropic API key, for [llm] provider = "anthropic"
ANTHROPIC_API_KEY=
# The OpenAI API key, for [llm] provider = "openai"
OPENAI_API_KEY=
# The Azure OpenAI key, for [llm] provider = "azure", with [azure_openai] endpoint set
AZURE_OPENAI_API_KEY=

# A Langfuse project's keys. With both set, every extraction's spans go to
# Langfuse, at the address in [langfuse] base_url. Unset, spans stay off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The reviews database, for [reviews] store = "postgres": a Postgres address,
# such as postgresql://user:password@host:5432/reviews. It can hold a password.
REVIEWS_DATABASE_URL=
