# Secrets and per-machine values only; every other setting lives in
# config/config.toml. Copy this file to config/.env and fill in what you
# need. Never commit config/.env. A load to DuckDB needs none of these.

# The Databricks SQL warehouse, for WAREHOUSE_DESTINATION=databricks and the
# dbt prod target: the workspace host, the warehouse's HTTP path (an output of
# the platform repository's databricks root) and a token.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# The Snowflake account, ORGNAME-ACCOUNTNAME, for WAREHOUSE_DESTINATION=snowflake
# and the dbt snowflake target. A GitHub job signs in with its own OIDC token,
# so only a run outside GitHub sets a token here.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=

# dlt sends no usage data to dltHub; the loaders also turn this off in code.
RUNTIME__DLTHUB_TELEMETRY=false
