########################################################################
#                              .gitignore                              #
########################################################################
# Author:            Kevin Street
# Created on:        2026-10-14
# Last modified on:  2026-10-29
#
# Keeps secrets, keys, caches, builds, runtime logs and generated
# data out of git.

# Secrets and keys: never committed (config/.env holds the secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_*
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
coverage/

# Runtime logs: kds.logs writes <log_dir>/YYYY-MM-DD.jsonl
logs/
*.log

# Generated data: the test documents, offline smoke results, audit files
data/generated/
data/evals/smoke/
.cache/
*.sqlite
*.db

# Editors and operating systems
.idea/
.vscode/
.DS_Store
